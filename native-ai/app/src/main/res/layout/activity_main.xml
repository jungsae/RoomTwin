<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RadioGroup
        android:id="@+id/modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkedButton="@id/room_mode"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:saveEnabled="false">

        <RadioButton
            android:id="@+id/room_mode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:saveEnabled="false"
            android:text="@string/room_mode" />

        <RadioButton
            android:id="@+id/playground_mode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:saveEnabled="false"
            android:text="@string/playground_mode" />
    </RadioGroup>

    <include
        android:id="@+id/room_panel"
        layout="@layout/view_room_analysis" />

    <include
        android:id="@+id/playground_panel"
        layout="@layout/view_playground"
        android:visibility="gone" />
</LinearLayout>
